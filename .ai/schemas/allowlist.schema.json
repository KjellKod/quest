{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quest Allowlist Configuration",
  "description": "Creator-managed permissions for quest orchestration.",
  "type": "object",
  "required": ["version", "auto_approve_phases", "review_mode", "role_permissions", "gates"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "auto_approve_phases": {
      "type": "object",
      "properties": {
        "plan_creation": { "type": "boolean" },
        "plan_review": { "type": "boolean" },
        "plan_refinement": { "type": "boolean" },
        "implementation": { "type": "boolean" },
        "code_review": { "type": "boolean" },
        "fix_loop": { "type": "boolean" }
      }
    },
    "quest_completion": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "on_complete": { "type": "string", "enum": ["ask", "celebrate", "archive_silent"] },
        "animation_style": { "type": "string" },
        "show_end_credits": { "type": "boolean" },
        "show_progress_bars": { "type": "boolean" },
        "ascii_art": { "type": "boolean" },
        "animation_speed": { "type": "string" },
        "safe_mode": { "type": "string" }
      }
    },
    "codex_fallback_model": {
      "type": "string",
      "minLength": 1,
      "description": "Default for standalone Codex delegation; also generates the shipped fallback for explicitly approved single-runtime continuation."
    },
    "codex_auth_mode": {
      "type": "string",
      "enum": ["cached", "api-key"],
      "default": "cached",
      "description": "Authentication for Claude-led Codex execution: cached CLI identity by default, or explicitly selected API-key billing. Saved per quest after preflight."
    },
    "codex_reasoning_effort": {
      "type": "string",
      "enum": ["low", "medium", "high", "xhigh", "max", "ultra"],
      "description": "Legacy fallback: reasoning effort for Codex roles absent from the per-role `effort` map. New quests should use `effort`."
    },
    "effort": {
      "type": "object",
      "propertyNames": {
        "enum": ["planner", "plan-reviewer-a", "plan-reviewer-b", "arbiter", "builder", "code-reviewer-a", "code-reviewer-b", "review-arbiter", "fixer"]
      },
      "additionalProperties": {
        "type": "string",
        "enum": ["low", "medium", "high", "xhigh", "max", "ultra"]
      },
      "description": "Reasoning effort per role, applied on whichever runtime the role's model selects. Partial overrides are supported at quest startup; the source-repository defaults generator requires every canonical role. `ultra` is Codex-only and blocks a Claude-backed role at sync or dispatch."
    },
    "models": {
      "type": "object",
      "propertyNames": {
        "enum": ["planner", "plan-reviewer-a", "plan-reviewer-b", "arbiter", "builder", "code-reviewer-a", "code-reviewer-b", "review-arbiter", "fixer"]
      },
      "additionalProperties": { "type": "string" }
    },
    "claude_role_transport": {
      "type": "string",
      "enum": ["auto", "background-agent", "bridge"],
      "default": "auto",
      "description": "Transport for Codex-led Claude roles: auto = background-agent when preflight proves it, otherwise block for user decision; background-agent = forced (preflight failure blocks); bridge = explicit legacy/API path."
    },
    "quest_startup": {
      "type": "object",
      "properties": {
        "branch_mode": {
          "type": "string",
          "enum": ["branch", "worktree", "none"]
        },
        "branch_prefix": { "type": "string" },
        "worktree_root": { "type": "string" }
      }
    },
    "quest_id_format": {
      "type": "string",
      "enum": ["slug-first", "date-first"]
    },
    "review_mode": { "type": "string", "enum": ["auto", "fast", "full"] },
    "fast_review_thresholds": {
      "type": "object",
      "properties": {
        "max_files": { "type": "integer", "minimum": 1 },
        "max_loc": { "type": "integer", "minimum": 1 }
      }
    },
    "role_permissions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "file_write": { "type": "array", "items": { "type": "string" } },
          "file_read": { "type": "array", "items": { "type": "string" } },
          "bash": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "solo": {
      "type": "object",
      "properties": {
        "max_fix_iterations": { "type": "integer", "minimum": 1 },
        "notes": { "type": "string" }
      }
    },
    "update_check": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval_days": { "type": "integer", "minimum": 1 }
      }
    },
    "gates": {
      "type": "object",
      "properties": {
        "require_approval_before_commit": { "type": "boolean" },
        "require_approval_before_push": { "type": "boolean" },
        "require_approval_before_delete": { "type": "boolean" },
        "max_plan_iterations": { "type": "integer", "minimum": 1 },
        "max_fix_iterations": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
