{
  "version": 2,
  "description": "Creator-managed permissions for quest orchestration. Edit this file to pre-approve or restrict quest agent actions. Changes take effect on next quest run.",
  "quest_completion": {
    "enabled": true,
    "on_complete": "celebrate",
    "animation_style": "epic",
    "show_end_credits": true,
    "show_progress_bars": true,
    "ascii_art": true,
    "animation_speed": "default",
    "safe_mode": "auto"
  },
  "auto_approve_phases": {
    "plan_creation": true,
    "plan_review": true,
    "plan_refinement": true,
    "implementation": false,
    "code_review": true,
    "fix_loop": true
  },
  "claude_role_transport": "auto",
  "codex_fallback_model": "gpt-6-astra",
  "codex_auth_mode": "cached",
  "codex_reasoning_effort": "medium",
  "models": {
    "planner": "gpt-6-astra",
    "plan-reviewer-a": "claude-opus-5-5",
    "plan-reviewer-b": "gpt-6-astra",
    "arbiter": "claude-opus-5-5",
    "builder": "gpt-6-astra",
    "code-reviewer-a": "claude-opus-5-5",
    "code-reviewer-b": "gpt-6-astra",
    "review-arbiter": "claude-opus-5-5",
    "fixer": "gpt-6-astra"
  },
  "effort": {
    "planner": "high",
    "plan-reviewer-a": "medium",
    "plan-reviewer-b": "medium",
    "arbiter": "high",
    "builder": "high",
    "code-reviewer-a": "high",
    "code-reviewer-b": "high",
    "review-arbiter": "high",
    "fixer": "medium"
  },
  "quest_startup": {
    "branch_mode": "branch",
    "branch_prefix": "quest/",
    "worktree_root": ".worktrees/quest"
  },
  "quest_id_format": "slug-first",
  "review_mode": "auto",
  "fast_review_thresholds": {
    "max_files": 5,
    "max_loc": 300
  },
  "role_permissions": {
    "planner_agent": {
      "file_write": [
        ".quest/**",
        "docs/**",
        "ideas/**",
        ".ai/**",
        "*.md"
      ],
      "file_read": [
        "**"
      ],
      "bash": [
        "find",
        "rg",
        "grep",
        "wc",
        "ls",
        "tree",
        "git status",
        "git diff",
        "gh pr view"
      ]
    },
    "plan_review_a": {
      "file_write": [
        ".quest/**"
      ],
      "file_read": [
        "**"
      ],
      "bash": [
        "pytest",
        "git status",
        "git diff",
        "git log",
        "rg",
        "grep",
        "find",
        "ls",
        "wc",
        "uv run pytest",
        "gh pr view",
        "python3 -m pytest"
      ]
    },
    "plan_review_b": {
      "file_write": [
        ".quest/**"
      ],
      "file_read": [
        "**"
      ],
      "bash": [
        "pytest",
        "git status",
        "git diff",
        "git log",
        "rg",
        "grep",
        "find",
        "ls",
        "wc",
        "uv run pytest",
        "gh pr view",
        "python3 -m pytest"
      ]
    },
    "arbiter_agent": {
      "file_write": [
        ".quest/**"
      ],
      "file_read": [
        "**"
      ],
      "bash": [
        "git status",
        "git diff",
        "gh pr view"
      ]
    },
    "review_arbiter_agent": {
      "file_write": [
        ".quest/**"
      ],
      "file_read": [
        "**"
      ],
      "bash": [
        "git status",
        "git diff",
        "gh pr view"
      ]
    },
    "builder_agent": {
      "file_write": [
        ".quest/**",
        ".ai/**",
        ".github/**",
        "docs/**",
        "ideas/**",
        "scripts/**",
        "tests/**",
        ".skills/**",
        "*.md",
        "*.json",
        "*.txt",
        "*.sh",
        "*.py"
      ],
      "file_read": [
        "**"
      ],
      "bash": [
        "python3 -m unittest",
        "pytest",
        "git status",
        "git diff",
        "git log",
        "npm test",
        "rg",
        "grep",
        "find",
        "ls",
        "wc",
        "python3 -m pytest",
        "bash scripts/quest_validate-manifest.sh",
        "bash scripts/quest_validate-quest-config.sh",
        "bash scripts/quest_validate-quest-state.sh",
        "bash tests/test-quest-preflight.sh",
        "bash tests/test-quest-orchestration.sh",
        "bash tests/test-quest-runtime.sh",
        "bash tests/test-validate-handoff-contracts.sh",
        "bash tests/test-validate-quest-state.sh"
      ]
    },
    "code_review_agent": {
      "file_write": [
        ".quest/**"
      ],
      "file_read": [
        "**"
      ],
      "bash": [
        "pytest",
        "git diff",
        "git log",
        "git status",
        "rg",
        "grep",
        "find",
        "ls",
        "wc",
        "uv run pytest",
        "gh pr view",
        "python3 -m pytest"
      ]
    },
    "fixer_agent": {
      "file_write": [
        ".quest/**",
        ".ai/**",
        ".github/**",
        "docs/**",
        "ideas/**",
        "scripts/**",
        "tests/**",
        ".skills/**",
        "*.md",
        "*.json",
        "*.txt",
        "*.sh",
        "*.py"
      ],
      "file_read": [
        "**"
      ],
      "bash": [
        "python3 -m unittest",
        "pytest",
        "git status",
        "git diff",
        "git log",
        "npm test",
        "rg",
        "grep",
        "find",
        "ls",
        "wc",
        "python3 -m pytest",
        "bash scripts/quest_validate-manifest.sh",
        "bash scripts/quest_validate-quest-config.sh",
        "bash scripts/quest_validate-quest-state.sh",
        "bash tests/test-quest-preflight.sh",
        "bash tests/test-quest-orchestration.sh",
        "bash tests/test-quest-runtime.sh",
        "bash tests/test-validate-handoff-contracts.sh",
        "bash tests/test-validate-quest-state.sh"
      ]
    }
  },
  "solo": {
    "max_fix_iterations": 2
  },
  "gates": {
    "require_approval_before_commit": true,
    "require_approval_before_push": true,
    "require_approval_before_delete": true,
    "max_plan_iterations": 3,
    "max_fix_iterations": 3
  }
}
