#!/bin/sh

hook_dir=$(CDPATH= cd -P "$(dirname "$0")" && pwd) || exit 1
repo_root=$(CDPATH= cd -P "$hook_dir/.." && pwd) || exit 1
cd "$repo_root" || exit 1

./scripts/quest_validate-quest-config.sh || exit $?

# Prefer the project virtualenv when present so venv-based workflows commit
# without PATH juggling; otherwise use python3 from PATH.
python3_bin="python3"
if [ -x ".venv/bin/python3" ]; then
  python3_bin=".venv/bin/python3"
fi

if ! "$python3_bin" -m black --version >/dev/null 2>&1; then
  cat >&2 <<EOF
black is not installed for ${python3_bin}.
Install the pinned development dependencies:
  ${python3_bin} -m pip install -e '.[dev]'
EOF
  exit 1
fi

if "$python3_bin" -m black --check .; then
  exit 0
fi

cat >&2 <<'EOF'
Python formatting check failed.
Format the repository, then retry the commit:
  python3 -m black .
EOF
exit 1
